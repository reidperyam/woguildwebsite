---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { guild } from '../data/guild';
// Vercel Speed Insights: real-visitor performance metrics. Only reports on Vercel deployments.
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
  // Link-preview image in public/ (1200x630), e.g. '/og-launch.png', with its alt text.
  image?: string;
  imageAlt?: string;
}
const { title, description, noindex = false, image, imageAlt } = Astro.props;
// Previews need absolute URLs; `site` in astro.config.mjs supplies the origin.
const imageUrl = image && new URL(image, Astro.site).href;
const fullTitle = title ? `${title} · ${guild.name}` : guild.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={guild.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site).href} />
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <!-- Bump ?v= whenever the icons change; browsers (Firefox especially) cache them by URL. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@400;800&display=swap" />
    <slot name="head" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <NavBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SpeedInsights />
  </body>
</html>
