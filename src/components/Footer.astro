---
import Monogram from './Monogram.astro';
import { guild, factsLine } from '../data/guild';
---

<footer class="foot">
  <div class="wrap foot-inner">
    <div class="who">
      <Monogram size={40} />
      <div>
        <p class="name">{guild.name}</p>
        <p class="label">{guild.game} · {factsLine}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot { border-top: var(--rule) solid var(--ink); }
  .foot-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); padding-block: var(--space-4); }
  .who { display: flex; align-items: center; gap: var(--space-2); }
  .name { font-weight: var(--fw-heavy); text-transform: uppercase; letter-spacing: 0.04em; line-height: 1.3; }
</style>
