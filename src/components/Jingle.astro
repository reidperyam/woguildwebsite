---
// The guild jingle: a play button and the sung words, which light up as they play.
// `custom` leaves the wiring to the page (the Howl Lab plays it with the visitor's own HAROOOO).
import { JINGLE_LYRICS } from '../scripts/jingle';

interface Props {
  label?: string;
  buttonClass?: string;
  custom?: boolean;
}
const { label = '▶ Play the jingle', buttonClass = 'btn btn-secondary', custom = false } = Astro.props;
---

<div class="jingle" data-jingle data-jingle-custom={custom ? '' : undefined}>
  <button type="button" class={buttonClass} data-jingle-play>{label}</button>
  <p class="jingle-words" aria-label="Werewolf, Orgasmahowl! Werewolf, Orgasmahowl! HAROOOO!">
    {JINGLE_LYRICS.map((line, l) => (
      <span class="jingle-line" aria-hidden="true">
        {line.map((word, w) => <span class="jingle-word" data-jingle-word={`${l}-${w}`}>{word}</span>)}
      </span>
    ))}
  </p>
</div>

<script>
  import { bindJingle } from '../scripts/jingle';
  document.querySelectorAll<HTMLElement>('[data-jingle]:not([data-jingle-custom])').forEach((root) => bindJingle(root));
</script>

<style>
  .jingle { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  .jingle-words { margin: 0; display: flex; flex-direction: column; gap: 6px; font-family: var(--font-mono); font-weight: var(--fw-heavy); font-size: clamp(13px, 1.6vw, 16px); letter-spacing: 0.04em; text-transform: uppercase; }
  .jingle-line { display: flex; flex-wrap: wrap; gap: 4px; }
  .jingle-word { padding: 2px 6px; border: 2px solid currentColor; opacity: 0.7; transition: opacity 0.08s, background-color 0.08s, color 0.08s; }
  .jingle-word.lit { opacity: 1; background: var(--jingle-lit-bg, var(--accent)); border-color: var(--jingle-lit-bg, var(--accent)); color: var(--jingle-lit-fg, var(--on-accent)); }
  @media (prefers-reduced-motion: reduce) { .jingle-word { transition: none; } }
</style>
