---
// A detail cropped from a picture of the Beast, like a museum close-up.
// The crop is in the image's own pixels; the browser zooms with background-size.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { Crop } from '../data/beast';

interface Props {
  image: ImageMetadata;
  crop: Crop;
  label: string;
  class?: string;
}
const { image, crop, label, class: cls } = Astro.props;
const W = image.width;
const H = image.height;
// Enough pixels for the crop at about 480px wide (a 240px detail on a 2x screen), never upscaled.
const width = Math.min(W, Math.ceil((W / crop.w) * 480));
const img = await getImage({ src: image, width, format: 'webp', quality: 90 });
const pos = (at: number, size: number, full: number) => (size >= full ? 0 : (at / (full - size)) * 100);
const style = [
  `aspect-ratio:${crop.w}/${crop.h}`,
  `background-image:url(${img.src})`,
  `background-size:${(W / crop.w) * 100}% auto`,
  `background-position:${pos(crop.x, crop.w, W)}% ${pos(crop.y, crop.h, H)}%`,
].join(';');
---

<span class:list={['crop', cls]} role="img" aria-label={label} style={style}></span>
