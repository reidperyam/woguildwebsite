---
import Monogram from './Monogram.astro';
import { discordHref } from '../data/guild';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/recruitment', label: 'Recruitment' },
  { href: '/lore', label: 'Lore' },
];
const fun = [
  { href: '/howl-lab', label: 'Howl Lab', note: 'Make your own HAROOOO!' },
];
const inFun = fun.some((f) => f.href === path);
---

<header class="nav-wrap">
  <nav class="wrap nav" aria-label="Main">
    <a class="brand" href="/">
      <Monogram size={52} />
      <span class="word">Werewolf Orgasmahowl</span>
    </a>
    <div class="links">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
      <details class="fun" data-fun>
        <summary class:list={{ current: inFun }}>Fun</summary>
        <div class="menu">
          {fun.map((f) => (
            <a href={f.href} aria-current={path === f.href ? 'page' : undefined}>
              <span class="menu-label">{f.label}</span>
              <span class="menu-note">{f.note}</span>
            </a>
          ))}
        </div>
      </details>
      <a class="btn btn-primary" href={discordHref}>Apply</a>
    </div>
  </nav>
</header>

<script>
  // Close the Fun menu on outside click or Escape.
  const fun = document.querySelector<HTMLDetailsElement>('[data-fun]');
  if (fun) {
    document.addEventListener('click', (e) => {
      if (fun.open && !fun.contains(e.target as Node)) fun.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && fun.open) {
        fun.open = false;
        fun.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .nav-wrap { position: relative; z-index: 20; border-bottom: var(--rule) solid var(--ink); background: var(--ground); }
  .nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4); padding-block: var(--space-2); }
  .brand { display: flex; align-items: center; gap: var(--space-2); color: var(--ink); text-decoration: none; }
  .word { font-size: 18px; font-weight: var(--fw-heavy); letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.2; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-4); }
  .links > a:not(.btn), .fun summary {
    display: inline-flex; align-items: center; min-height: var(--target-min);
    color: var(--ink); font-size: var(--fs-button); font-weight: var(--fw-heavy);
    letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; cursor: pointer;
  }
  .links > a:not(.btn):hover, .fun summary:hover { color: var(--accent); }
  .links > a[aria-current='page'], .fun summary.current { text-decoration: underline; text-decoration-thickness: var(--rule); text-decoration-color: var(--accent); text-underline-offset: 6px; }

  .fun { position: relative; }
  .fun summary { list-style: none; gap: 8px; }
  .fun summary::-webkit-details-marker { display: none; }
  .fun summary::after { content: ''; width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 7px solid currentColor; transition: transform 0.15s ease; }
  .fun[open] summary::after { transform: rotate(180deg); }
  .menu {
    position: absolute; top: calc(100% + 8px); right: 0; min-width: 280px; z-index: 30;
    display: flex; flex-direction: column; background: var(--ground); border: var(--rule) solid var(--ink);
  }
  .menu a { display: flex; flex-direction: column; gap: 4px; padding: var(--space-2) var(--space-3); color: var(--ink); text-decoration: none; min-height: var(--target-min); }
  .menu a + a { border-top: var(--rule) solid var(--ink); }
  .menu a:hover, .menu a:focus-visible { background: var(--accent); color: var(--on-accent); }
  .menu a[aria-current='page'] .menu-label { text-decoration: underline; text-decoration-thickness: var(--rule); text-underline-offset: 6px; }
  .menu-label { font-size: var(--fs-button); font-weight: var(--fw-heavy); letter-spacing: 0.08em; text-transform: uppercase; }
  .menu-note { font-size: var(--fs-label); letter-spacing: 0.04em; }

  @media (max-width: 480px) {
    .word { font-size: 15px; }
    .links { gap: var(--space-1) var(--space-3); }
    .menu { right: auto; left: 0; min-width: min(280px, calc(100vw - 32px)); }
  }
</style>
