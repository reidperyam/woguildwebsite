---
// SVG symbols for the Bearwolftriceratiger page (The Storm sub-theme). Use with <svg><use href="#bw-…" /></svg>.
// The tiger-stripe divider is generated once here so every stripe band matches.
const stripes = Array.from({ length: 24 }, (_, i) => {
  const x = i * 20 + [0, 3, -2, 4, 1, -3][i % 6];
  const w = 8 + ((i * 7) % 5);
  const reach = 16 + ((i * 11) % 8);
  // Alternate wedges reach down from the top edge and up from the bottom, curved like fur.
  return i % 2 === 0
    ? `M${x} 0 L${x + w} 0 Q${x + w + 2} ${reach * 0.6} ${x + w + 6} ${reach} Q${x + 2} ${reach * 0.55} ${x} 0 Z`
    : `M${x} 26 L${x + w} 26 Q${x + w - 2} ${26 - reach * 0.6} ${x - 6} ${26 - reach} Q${x + 3} ${26 - reach * 0.5} ${x} 26 Z`;
}).join(' ');

// The sigil's frill: short knobbed spikes standing out from the edge of the fan, like a triceratops.
const frillEdge: [number, number][] = [[134, 116], [152, 92], [178, 76], [208, 70], [238, 76], [262, 94], [276, 120], [280, 146]];
const frillSpikes = frillEdge.map(([x, y]) => {
  const dx = x - 205, dy = y - 140;
  const len = Math.hypot(dx, dy);
  const nx = dx / len, ny = dy / len;
  const tx = -ny * 8, ty = nx * 8;
  const r = (v: number) => v.toFixed(1);
  return `M${r(x + tx)} ${r(y + ty)} L${r(x + nx * 20)} ${r(y + ny * 20)} L${r(x - tx)} ${r(y - ty)}Z`;
}).join(' ');
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
