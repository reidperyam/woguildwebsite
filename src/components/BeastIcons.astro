    <!-- The sigil: the whole Beast in silhouette, in the painting's charging pose (facing left,
         crown of horns, open jaws, raised claw, curled tail). Solid currentColor; the eye and tiger
         stripes are cut out in --sigil-cut (black by default), so it can sit on black or on yellow. -->
    <symbol id="bw-sigil" viewBox="0 0 400 350">
      <path d="M344 236 C372 250 386 228 378 206 C373 190 380 180 392 176" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round" />
