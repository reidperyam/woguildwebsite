        <path d="M10 8 20 16M54 8 44 16" />
        <path d="M32 12c15 0 24 10 24 24 0 13-10 22-24 22S8 49 8 36c0-14 9-24 24-24Z" />
        <path d="M32 14v8M24 16l2 7M40 16l-2 7" />
        <path d="M9 34h8M9 42h7M55 34h-8M55 42h-7" />
        <path d="M26 46 32 51l6-5" />
      </g>
      <g fill="currentColor"><path d="M19 30 28 32 21 36Z" /><path d="M45 30 36 32 43 36Z" /></g>
