        <path d="M246 162 Q256 192 244 222 Q264 194 262 164Z M272 170 Q282 202 270 238 Q292 204 288 174Z M298 184 Q306 214 294 250 Q316 216 312 190Z M322 202 Q330 230 318 264 Q340 232 334 208Z" />
      </g>
