        <path d="M140 178 C160 152 220 142 262 160 C302 175 335 190 345 225 C352 250 345 275 330 282 L300 290 C270 290 240 285 215 280 C190 275 165 255 152 236 C142 222 136 200 140 178Z" />
        <path d="M300 270 C320 280 326 300 322 318 L332 336 L298 336 L300 318 C296 305 285 292 278 285Z M298 336 L286 342 L308 338Z M332 336 L344 342 L322 338Z" />
        <path d="M205 268 C200 290 195 305 188 318 L176 332 L226 334 L222 318 C226 300 232 285 238 275Z M176 332 L162 340 L186 336Z M194 334 L186 344 L202 336Z M212 334 L210 345 L220 335Z M226 334 L238 341 L222 330Z" />
        <g transform="rotate(16 150 156)">
          <path d="M128 152 C130 100 170 64 214 66 C258 70 286 106 282 152 C250 166 180 168 128 152Z" />
          <path d={frillSpikes} />
        </g>
        <path d="M132 134 Q98 92 68 40 Q118 80 160 116Z" />
        <path d="M118 148 Q82 112 32 72 Q98 94 148 128Z" />
        <path d="M164 140 C142 128 112 132 92 146 L64 162 L70 180 L82 168 C100 168 124 170 150 172Z" />
        <path d="M94 150 L78 122 L108 146Z" />
        <path d="M96 167 L100 181 L105 168Z M114 169 L117 181 L122 170Z" />
        <path d="M152 186 C128 188 104 190 84 188 L82 198 C104 204 130 204 158 200Z" />
        <path d="M102 190 L106 179 L111 190Z" />
        <path d="M180 206 C148 206 112 202 86 196 L78 212 C106 222 146 234 180 244Z" />
        <path d="M88 190 C68 180 50 190 50 206 C52 220 68 226 86 216Z" />
        <path d="M54 192 C40 190 28 198 24 212 C32 205 42 203 52 201Z M52 202 C38 204 30 214 30 228 C36 219 44 214 54 210Z M56 211 C46 218 42 230 44 242 C48 232 54 225 62 219Z M66 218 C60 228 60 240 64 250 C66 240 70 232 76 224Z" />
      </g>
      <g style="fill: var(--sigil-cut, #000)">
